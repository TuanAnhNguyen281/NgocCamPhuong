APP_NAME=Ngoc Cam Phuong API
# local | production
APP_ENV=local
# Local: PostgreSQL tren may. Production: chuoi "Pooled connection" cua Neon (host co -pooler, kem ?sslmode=require).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ngoc_cam_phuong
# Origin cua frontend, khong co dau / cuoi. Nhieu origin thi cach nhau bang dau phay.
FRONTEND_ORIGIN=http://localhost:5173
# Production bat buoc >= 32 ky tu. Tao bang: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-this-local-secret
# OAuth Client ID (Web application) tu Google Cloud Console, giong VITE_GOOGLE_CLIENT_ID o frontend.
GOOGLE_CLIENT_ID=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ngoc-cam-phuong/products

# Chi dung khi chay "npm run db:setup" de tao admin dau tien. Khong can khai bao tren Vercel.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# Email (xac nhan don hang, dat lai mat khau) gui qua https://resend.com.
# De trong thi backend chi ghi log va bo qua viec gui email.
RESEND_API_KEY=
# Dia chi gui da duoc xac minh tren Resend, vi du: Ngoc Cam Phuong <donhang@tenmien.vn>
MAIL_FROM=
